                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="@dimen/quick_action_icon_size"
                            android:layout_height="@dimen/quick_action_icon_size"
                            android:layout_marginBottom="8dp"
                            android:contentDescription="Registrar equipo"
