<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/adminCoordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    tools:context=".AdminActivity">

    <!-- ====== SECCIÓN: CONTENIDO DESPLAZABLE ====== -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNewTicket"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="Nuevo ticket"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/primary_navy"
        app:layout_anchor="@id/bottomNav"
        app:layout_anchorGravity="top|end"
        app:tint="@color/white" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/adminScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/bottom_nav_height"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_horizontal_padding"
            android:paddingTop="12dp"
            android:paddingBottom="@dimen/content_bottom_padding">

            <!-- ====== SECCIÓN 1: CABECERA / TOP BAR ====== -->
            <LinearLayout
                android:id="@+id/headerBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Botón de soporte técnico (izquierda) -->
                <ImageButton
                    android:id="@+id/btnSupport"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Soporte"
                    android:src="@drawable/ic_headset"
                    android:tint="@color/primary_navy" />

                <!-- Título y subtítulo alineados a la izquierda -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hola, Administrador"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/header_title_size"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resumen de incidencias de Perfumería VIP"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/header_subtitle_size" />
                </LinearLayout>

                <!-- Avatar / perfil de usuario (derecha) -->
                <ImageView
                    android:id="@+id/imgProfileAvatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Perfil"
                    android:src="@drawable/ic_account_circle"
                    android:tint="@color/primary_navy" />
            </LinearLayout>

            <!-- ====== SECCIÓN 2: HERO CARD / MÉTRICAS PRINCIPALES ====== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                app:cardBackgroundColor="@color/primary_navy"
                app:cardCornerRadius="@dimen/card_corner_radius_large"
                app:cardElevation="@dimen/card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtHeroLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:alpha="0.7"
                            android:text="Total Tickets"
                            android:textColor="@color/white"
                            android:textSize="@dimen/hero_label_size"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/icHeroTicket"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:alpha="0.5"
                            android:contentDescription="Total Tickets"
                            android:src="@drawable/ic_ticket"
                            android:tint="@color/white" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtHeroNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="20"
                        android:textColor="@color/white"
                        android:textSize="@dimen/hero_number_size"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ====== SECCIÓN 3: MATRIZ DE RESUMEN DE ESTADOS (GRID 2x2) ====== -->
            <!-- Fila 1: CRÍTICOS + PENDIENTES -->
            <LinearLayout
                android:id="@+id/statusRow1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:orientation="horizontal">

                <!-- Tarjeta 1: CRÍTICOS -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_status_dot"
                                android:backgroundTint="@color/critical" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:letterSpacing="0.08"
                                android:text="CRÍTICOS"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/status_label_size"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="5"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/status_number_size"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Tarjeta 2: PENDIENTES -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_status_dot"
                                android:backgroundTint="@color/amber" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:letterSpacing="0.08"
                                android:text="PENDIENTES"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/status_label_size"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="8"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/status_number_size"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Fila 2: EN PROCESO + SOLUCIONADOS -->
            <LinearLayout
                android:id="@+id/statusRow2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <!-- Tarjeta 3: EN PROCESO -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_status_dot"
                                android:backgroundTint="@color/info_blue" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:letterSpacing="0.08"
                                android:text="EN PROCESO"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/status_label_size"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="3"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/status_number_size"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Tarjeta 4: SOLUCIONADOS -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_status_dot"
                                android:backgroundTint="@color/green" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:letterSpacing="0.08"
                                android:text="SOLUCIONADOS"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/status_label_size"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="4"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/status_number_size"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ====== SECCIÓN 4: INCIDENCIAS RECIENTES ====== -->
            <!-- Cabecera: título + enlace "Ver todas" -->
            <LinearLayout
                android:id="@+id/recentHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Incidencias recientes"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/title_size"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Ver todas >"
                    android:textColor="@color/info_blue"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/recentList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Item 1: #001 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- Fila superior: ID + badges (se envuelve si no cabe) -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="8dp"
                                    android:text="#001"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/bg_badge"
                                    android:backgroundTint="@color/critical_bg"
                                    android:paddingHorizontal="@dimen/badge_h_padding"
                                    android:paddingVertical="@dimen/badge_v_padding"
                                    android:text="Crítica"
                                    android:textColor="@color/critical"
                                    android:textSize="@dimen/badge_text_size"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_badge"
                                    android:backgroundTint="@color/info_blue_bg"
                                    android:paddingHorizontal="@dimen/badge_h_padding"
                                    android:paddingVertical="@dimen/badge_v_padding"
                                    android:text="En proceso"
                                    android:textColor="@color/info_blue"
                                    android:textSize="@dimen/badge_text_size"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Fila inferior: descripción -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Impresora HP no imprime color"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!-- Flecha indicadora -->
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Ver detalle"
                            android:src="@drawable/ic_chevron_right"
                            android:tint="@color/text_secondary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Item 2: #002 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- Fila superior: ID + badges -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="8dp"
                                    android:text="#002"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/bg_badge"
                                    android:backgroundTint="@color/amber_bg"
                                    android:paddingHorizontal="@dimen/badge_h_padding"
                                    android:paddingVertical="@dimen/badge_v_padding"
                                    android:text="Media"
                                    android:textColor="@color/amber"
                                    android:textSize="@dimen/badge_text_size"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_badge"
                                    android:backgroundTint="@color/amber_bg"
                                    android:paddingHorizontal="@dimen/badge_h_padding"
                                    android:paddingVertical="@dimen/badge_v_padding"
                                    android:text="Pendiente"
                                    android:textColor="@color/amber"
                                    android:textSize="@dimen/badge_text_size"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Fila inferior: descripción -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PC-003 Pantalla azul al iniciar"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!-- Flecha indicadora -->
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Ver detalle"
                            android:src="@drawable/ic_chevron_right"
                            android:tint="@color/text_secondary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Item 3: #003 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- Fila superior: ID + badges -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="8dp"
                                    android:text="#003"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/bg_badge"
                                    android:backgroundTint="@color/green_bg"
                                    android:paddingHorizontal="@dimen/badge_h_padding"
                                    android:paddingVertical="@dimen/badge_v_padding"
                                    android:text="Baja"
                                    android:textColor="@color/green"
                                    android:textSize="@dimen/badge_text_size"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_badge"
                                    android:backgroundTint="@color/green_bg"
                                    android:paddingHorizontal="@dimen/badge_h_padding"
                                    android:paddingVertical="@dimen/badge_v_padding"
                                    android:text="Solucionado"
                                    android:textColor="@color/green"
                                    android:textSize="@dimen/badge_text_size"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Fila inferior: descripción -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Reemplazo de teclado PC-002"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!-- Flecha indicadora -->
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Ver detalle"
                            android:src="@drawable/ic_chevron_right"
                            android:tint="@color/text_secondary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ====== SECCIÓN 5: ACCIONES RÁPIDAS ====== -->
            <!-- Título -->
            <TextView
                android:id="@+id/txtQuickActionsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:layout_marginBottom="4dp"
                android:text="Acciones rápidas"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/title_size"
                android:textStyle="bold" />

            <!-- Fila 1: Gestionar tickets + Registrar equipo -->
            <LinearLayout
                android:id="@+id/qaRow1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="@dimen/quick_action_icon_size"
                            android:layout_height="@dimen/quick_action_icon_size"
                            android:layout_marginBottom="8dp"
                            android:contentDescription="Gestionar tickets"
                            android:src="@drawable/ic_ticket"
                            android:tint="@color/primary_navy" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Gestionar tickets"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

