<?xml version="1.0" encoding="utf-8"?>
<!-- ponytail: Dashboard de Usuario — diseño UI estático, sin lógica de negocio -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/userDashboardCoordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <!-- FAB flotante -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNewTicket"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/fab_margin"
        android:layout_marginBottom="@dimen/fab_margin"
        android:contentDescription="@string/dashboard_fab_description"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/primary_navy"
        app:tint="@color/white" />

    <!-- Contenido desplazable -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/bottom_nav_height"
        android:clipToPadding="false"
        android:overScrollMode="never">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/userDashboardScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_horizontal_padding"
            android:paddingTop="12dp"
            android:paddingBottom="@dimen/content_bottom_padding">

            <!-- ====== SECCION 1: CABECERA / SALUDO ====== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_greeting"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/header_title_size"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/dashboard_subtitle"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/header_subtitle_size" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgSupport"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/nav_tickets"
                    android:src="@drawable/ic_headset"
                    app:tint="@color/primary_navy" />
            </LinearLayout>

            <!-- ====== SECCION 2: BOTON CREAR TICKET ====== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCreateTicket"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/primary_navy"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="@string/dashboard_create_ticket"
                        android:src="@drawable/ic_add"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_create_ticket"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ====== SECCION 3: TARJETAS DE METRICAS (tarjetas apiladas) ====== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:orientation="vertical">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressCargandoMetricas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/primary_navy"
                    app:trackThickness="4dp" />

                <!-- Card: PENDIENTES -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/bg_status_dot"
                                    android:backgroundTint="@color/amber" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:letterSpacing="0.06"
                                    android:text="@string/dashboard_pending"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="@dimen/status_label_size"
                                    android:textStyle="bold" />
                            </LinearLayout>

<TextView
                            android:id="@+id/txtPendingCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="0"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/status_number_size"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:contentDescription="@string/dashboard_pending_subtitle"
                                    android:src="@drawable/ic_hourglass"
                                    app:tint="@color/text_secondary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="@string/dashboard_pending_subtitle"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:layout_gravity="top|end"
                            android:layout_marginEnd="-50dp"
                            android:layout_marginTop="-50dp"
                            android:alpha="0.35"
                            android:background="@drawable/bg_status_dot"
                            android:backgroundTint="@color/amber" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card: EN PROCESO -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/bg_status_dot"
                                    android:backgroundTint="@color/info_blue" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:letterSpacing="0.06"
                                    android:text="@string/dashboard_in_process"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="@dimen/status_label_size"
                                    android:textStyle="bold" />
                            </LinearLayout>

<TextView
                            android:id="@+id/txtInProcessCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="0"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/status_number_size"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:contentDescription="@string/dashboard_in_process_subtitle"
                                    android:src="@drawable/ic_hourglass"
                                    app:tint="@color/text_secondary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="@string/dashboard_in_process_subtitle"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:layout_gravity="top|end"
                            android:layout_marginEnd="-50dp"
                            android:layout_marginTop="-50dp"
                            android:alpha="0.35"
                            android:background="@drawable/bg_status_dot"
                            android:backgroundTint="@color/info_blue" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card: SOLUCIONADOS -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/bg_status_dot"
                                    android:backgroundTint="@color/green" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:letterSpacing="0.06"
                                    android:text="@string/dashboard_resolved"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="@dimen/status_label_size"
                                    android:textStyle="bold" />
                            </LinearLayout>

<TextView
                            android:id="@+id/txtResolvedCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="0"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/status_number_size"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:contentDescription="@string/dashboard_resolved_subtitle"
                                    android:src="@drawable/ic_hourglass"
                                    app:tint="@color/text_secondary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="@string/dashboard_resolved_subtitle"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:layout_gravity="top|end"
                            android:layout_marginEnd="-50dp"
                            android:layout_marginTop="-50dp"
                            android:alpha="0.35"
                            android:background="@drawable/bg_status_dot"
                            android:backgroundTint="@color/green" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ====== SECCION 4: TICKETS RECIENTES - CABECERA ====== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dashboard_recent_tickets"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/title_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtViewAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/dashboard_view_all"
                    android:textColor="@color/info_blue"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ====== SECCION 5: FILTROS POR ESTADO ====== -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupRecentFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterTodos"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:checked="true"
                        android:text="@string/filter_all"
                        app:checkedIconEnabled="false"
                        app:chipBackgroundColor="@color/priority_chip_bg"
                        app:chipCornerRadius="@dimen/badge_corner_radius"
                        app:chipStrokeColor="@color/priority_chip_stroke"
                        app:chipStrokeWidth="1dp"
                        android:textColor="@color/priority_chip_text" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterPendientes"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="@string/filter_pendiente"
                        app:checkedIconEnabled="false"
                        app:chipBackgroundColor="@color/status_chip_bg_pendiente"
                        app:chipCornerRadius="@dimen/badge_corner_radius"
                        app:chipStrokeColor="@color/pending_status"
                        app:chipStrokeWidth="1dp"
                        android:textColor="@color/status_chip_text_pendiente" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterEnProceso"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="@string/filter_en_proceso"
                        app:checkedIconEnabled="false"
                        app:chipBackgroundColor="@color/status_chip_bg_en_proceso"
                        app:chipCornerRadius="@dimen/badge_corner_radius"
                        app:chipStrokeColor="@color/info_blue"
                        app:chipStrokeWidth="1dp"
                        android:textColor="@color/status_chip_text_en_proceso" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterSolucionados"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="@string/filter_solucionados"
                        app:checkedIconEnabled="false"
                        app:chipBackgroundColor="@color/status_chip_bg_solucionado"
                        app:chipCornerRadius="@dimen/badge_corner_radius"
                        app:chipStrokeColor="@color/green"
                        app:chipStrokeWidth="1dp"
                        android:textColor="@color/status_chip_text_solucionado" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- ====== SECCION 6: LISTA DE TICKETS RECIENTES ====== -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressCargando"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="28dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/primary_navy"
                app:trackThickness="4dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerRecentTickets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

        </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Bottom Navigation - 3 tabs usuario -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_gravity="bottom"
        android:background="@color/white"
        app:elevation="8dp"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_nav_user" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
