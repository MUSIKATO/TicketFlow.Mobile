<?xml version="1.0" encoding="utf-8"?>
<!-- ponytail: Mis Tickets — UI estática, filtros y lista mock, sin lógica -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/userTicketsCoordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNewTicket"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/fab_margin"
        android:layout_marginBottom="@dimen/fab_margin"
        android:contentDescription="@string/dashboard_fab_description"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/primary_navy"
        app:tint="@color/white" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/userTicketsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/bottom_nav_height"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_horizontal_padding"
            android:paddingTop="12dp"
            android:paddingBottom="@dimen/content_bottom_padding">

            <!-- Titulo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_mis_tickets"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/header_title_size"
                android:textStyle="bold" />

            <!-- Filtros / pills horizontales -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterTodos"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:checked="true"
                        android:text="@string/filter_all"
                        app:checkedIconEnabled="false"
                        app:chipBackgroundColor="@color/priority_chip_bg"
                        app:chipCornerRadius="@dimen/badge_corner_radius"
                        app:chipStrokeColor="@color/priority_chip_stroke"
                        app:chipStrokeWidth="1dp"
                        android:textColor="@color/priority_chip_text" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterPendientes"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="@string/filter_pendiente"
                        app:checkedIconEnabled="false"
                        app:chipBackgroundColor="@color/priority_chip_bg"
                        app:chipCornerRadius="@dimen/badge_corner_radius"
                        app:chipStrokeColor="@color/priority_chip_stroke"
                        app:chipStrokeWidth="1dp"
                        android:textColor="@color/priority_chip_text" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterEnProceso"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="@string/filter_en_proceso"
                        app:checkedIconEnabled="false"
                        app:chipBackgroundColor="@color/priority_chip_bg"
                        app:chipCornerRadius="@dimen/badge_corner_radius"
                        app:chipStrokeColor="@color/priority_chip_stroke"
                        app:chipStrokeWidth="1dp"
                        android:textColor="@color/priority_chip_text" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterSolucionados"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="@string/filter_solucionados"
                        app:checkedIconEnabled="false"
                        app:chipBackgroundColor="@color/priority_chip_bg"
                        app:chipCornerRadius="@dimen/badge_corner_radius"
                        app:chipStrokeColor="@color/priority_chip_stroke"
                        app:chipStrokeWidth="1dp"
                        android:textColor="@color/priority_chip_text" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Lista de tickets -->
            <!-- Ticket #001 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTicket1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ticket_id_001"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ticket_fecha_001"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/ticket_equipo_001"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_badge"
                                android:backgroundTint="@color/critical_bg"
                                android:paddingHorizontal="@dimen/badge_h_padding"
                                android:paddingVertical="@dimen/badge_v_padding"
                                android:text="@string/ticket_priority_critica"
                                android:textColor="@color/critical"
                                android:textSize="@dimen/badge_text_size"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge"
                                android:backgroundTint="@color/info_blue_bg"
                                android:paddingHorizontal="@dimen/badge_h_padding"
                                android:paddingVertical="@dimen/badge_v_padding"
                                android:text="@string/ticket_status_en_proceso"
                                android:textColor="@color/info_blue"
                                android:textSize="@dimen/badge_text_size"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/ticket_ver_detalle"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Ticket #002 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTicket2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ticket_id_002"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ticket_fecha_002"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/ticket_equipo_002"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_badge"
                                android:backgroundTint="@color/amber_bg"
                                android:paddingHorizontal="@dimen/badge_h_padding"
                                android:paddingVertical="@dimen/badge_v_padding"
                                android:text="@string/ticket_priority_media"
                                android:textColor="@color/amber"
                                android:textSize="@dimen/badge_text_size"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge"
                                android:backgroundTint="@color/pending_status_bg"
                                android:paddingHorizontal="@dimen/badge_h_padding"
                                android:paddingVertical="@dimen/badge_v_padding"
                                android:text="@string/ticket_status_pendiente"
                                android:textColor="@color/pending_status"
                                android:textSize="@dimen/badge_text_size"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/ticket_ver_detalle"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Ticket #003 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTicket3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ticket_id_003"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ticket_fecha_003"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/ticket_equipo_003"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_badge"
                                android:backgroundTint="@color/green_bg"
                                android:paddingHorizontal="@dimen/badge_h_padding"
                                android:paddingVertical="@dimen/badge_v_padding"
                                android:text="@string/ticket_priority_baja"
                                android:textColor="@color/green"
                                android:textSize="@dimen/badge_text_size"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge"
                                android:backgroundTint="@color/green_bg"
                                android:paddingHorizontal="@dimen/badge_h_padding"
                                android:paddingVertical="@dimen/badge_v_padding"
                                android:text="@string/ticket_status_solucionado"
                                android:textColor="@color/green"
                                android:textSize="@dimen/badge_text_size"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/ticket_ver_detalle"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_gravity="bottom"
        android:background="@color/white"
        app:elevation="8dp"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_nav_user" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>