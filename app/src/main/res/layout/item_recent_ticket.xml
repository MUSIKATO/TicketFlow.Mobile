<?xml version="1.0" encoding="utf-8"?>
<!-- Plantilla de item para RecyclerView de "Incidencias recientes".
     Usar como modelo de inflado cuando se implemente la lógica/adapter.
     Los datos aquí son de ejemplo (Item 1: #001). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Fila superior: ID + badges (prioridad, estado) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtTicketId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="#001"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtBadgePriority"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_badge"
                    android:backgroundTint="@color/critical_bg"
                    android:paddingHorizontal="@dimen/badge_h_padding"
                    android:paddingVertical="@dimen/badge_v_padding"
                    android:text="Crítica"
                    android:textColor="@color/critical"
                    android:textSize="@dimen/badge_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtBadgeStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge"
                    android:backgroundTint="@color/info_blue_bg"
                    android:paddingHorizontal="@dimen/badge_h_padding"
                    android:paddingVertical="@dimen/badge_v_padding"
                    android:text="En proceso"
                    android:textColor="@color/info_blue"
                    android:textSize="@dimen/badge_text_size"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Fila inferior: descripción -->
            <TextView
                android:id="@+id/txtTicketDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Impresora HP no imprime color"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Flecha indicadora -->
        <ImageView
            android:id="@+id/imgTicketArrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Ver detalle"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/text_secondary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>